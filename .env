# docker postgres
POSTGRES_VERSION=15
CONTAINER_PREFIX=pg_homelab_postgres
DB_HOST=localhost
POSTGRES_PORT=5433

# DOCKER (dev + prod)
CRAWLER_DB_NAME=pg_homelab_postgres_db
DOCKER_DB_USER=foo_user
DOCKER_DB_PASSWORD=foo_password
CRAWLER_DB_PORT=${POSTGRES_PORT}
DB_URL=jdbc:postgresql://${DB_HOST}:${POSTGRES_PORT}/${CRAWLER_DB_NAME}
